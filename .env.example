# Copie para .env.local em desenvolvimento ou configure estes valores nos ambientes do Vercel.
# Use sempre uma chave pública do Supabase (anon/publishable); nunca use service_role.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key
# Compatibilidade com projetos que ainda usam a variável antiga:
# VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key
VITE_WHATSAPP_NUMBER=+5511999999999
VITE_STORE_NAME=Madu Acessórios
