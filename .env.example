# Copie para .env.local em desenvolvimento ou disponibilize no ambiente de build do Firebase Hosting.
# Use sempre uma chave pública do Supabase (anon/publishable); nunca use service_role.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key
# Compatibilidade com projetos legados:
# VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key
VITE_WHATSAPP_NUMBER=
VITE_STORE_NAME=Madu Acessórios
